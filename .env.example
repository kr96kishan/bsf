# API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Google Maps API Key - Get from https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Transit API Key - For general transit information
VITE_TRANSIT_API_KEY=YOUR_TRANSIT_API_KEY

# Bangalore Metro API Key - Get from https://www.bmrc.co.in/
VITE_BANGALORE_METRO_API_KEY=YOUR_BANGALORE_METRO_API_KEY

# BMTC Bus API Key - Get from https://www.bmtcinfo.com/
VITE_BMTC_BUS_API_KEY=YOUR_BMTC_BUS_API_KEY

# Location API Key - For location-based services
VITE_LOCATION_API_KEY=YOUR_LOCATION_API_KEY
